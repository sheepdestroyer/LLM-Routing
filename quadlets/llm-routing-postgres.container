[Unit]
Description=PostgreSQL — Langfuse + LiteLLM metadata store (POD_NAME_PLACEHOLDER)

[Container]
ContainerName=POD_NAME_PLACEHOLDER-postgres-db
Image=POSTGRES_IMAGE_PLACEHOLDER
Label=wud.tag.include=^.*-pg18$
Label=wud.tag.exclude=.*(trixie|bookworm|bullseye).*
Pod=llm-routing.pod
# play-kube injected <pod-name> -> 127.0.0.1 into /etc/hosts; replicate for apps
# (langfuse 3.222+) that resolve the pod hostname for self/intra-pod calls.
AddHost=POD_NAME_PLACEHOLDER:127.0.0.1
Environment=POSTGRES_USER=postgres
# Podman secret created by start-stack.sh render_quadlets() from .env (same value);
# keeps the password out of this unit and `podman inspect`. Clients still use
# DATABASE_URL with the URL-encoded password.
Secret=POSTGRES_PASSWORD_SECRET_PLACEHOLDER,type=env,target=POSTGRES_PASSWORD
Environment=POSTGRES_DB=langfuse
Environment=PGDATA=/var/lib/postgresql/data/pg18
Environment=PGPORT=POSTGRES_PORT_PLACEHOLDER
Volume=DATA_ROOT_PLACEHOLDER/postgres-data:/var/lib/postgresql
# Client auth (pg_hba.conf) generated by start-stack.sh generate_postgres_hba(): scram-sha-256
# on 127.0.0.1/::1, peer for the postgres OS user on the in-container socket. Loaded via
# -c hba_file= so it also covers existing clusters (initdb never rewrites $PGDATA/pg_hba.conf,
# whose image default trusts loopback). Private to this container: :Z.
Volume=DATA_ROOT_PLACEHOLDER/postgres-config/pg_hba.conf:/etc/postgresql/pg_hba.conf:ro,Z
Exec=postgres -c log_checkpoints=off -c log_min_messages=warning -c listen_addresses=127.0.0.1,::1 -c hba_file=/etc/postgresql/pg_hba.conf
# Incident 2026-10-31 15:25: a ~90 s host disk stall timed out the exec healthcheck;
# the orphaned exec child was reparented to postgres (then PID 1), died of SIGPIPE,
# and the postmaster treated the "untracked child process" as a backend crash and
# did a full crash-restart (~65 s down). RunInit= puts catatonit at PID 1 so it,
# not the postmaster, reaps orphaned healthcheck/`podman exec` children.
RunInit=true
# -q: no stdout to write (no SIGPIPE if the reader is gone). Timeout < interval so
# checks never overlap. kill stays as the safety net for a wedged postmaster, but
# only after 9 consecutive failures (>= 3 min): postgres recovers from I/O stalls
# by itself, and killing it mid-stall only adds crash recovery on top of the stall.
HealthCmd=pg_isready -q -U postgres -p POSTGRES_PORT_PLACEHOLDER
HealthInterval=20s
HealthTimeout=15s
HealthOnFailure=kill
HealthRetries=9
HealthStartPeriod=60s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target llm-routing-pod.service

